<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yudi.ticket.mapper.ScenicStockMapper">

    <resultMap id="BaseResultMap" type="com.yudi.ticket.model.entity.ScenicStock">
            <id property="id" column="id" jdbcType="BIGINT"/>
            <result property="scenicId" column="scenic_id" jdbcType="BIGINT"/>
            <result property="stockDate" column="stock_date" jdbcType="DATE"/>
            <result property="totalQty" column="total_qty" jdbcType="INTEGER"/>
            <result property="soldQty" column="sold_qty" jdbcType="INTEGER"/>
            <result property="lockVersion" column="lock_version" jdbcType="INTEGER"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,scenic_id,stock_date,
        total_qty,sold_qty,lock_version
    </sql>
</mapper>
